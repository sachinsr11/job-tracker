# Telegram: message @BotFather on Telegram to create a bot and get a token.
# For chat ID: message your new bot once, then visit
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Groq: free API key from https://console.groq.com
GROQ_API_KEY=

# Supabase: Project Settings -> API. Use the service_role key (bypasses RLS),
# never the anon key, and never commit this value or expose it client-side.
SUPABASE_URL=
SUPABASE_KEY=